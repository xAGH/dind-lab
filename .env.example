# Copia este archivo a .env y ajusta los valores. .env nunca se sube al repo.

# --- Red / dominio ---
LAB_HOST=docker-lab.areasoftccyt.com
LAB_NETWORK=lab-net
LAB_ENTRYPOINT=websecure
# Debe existir ya en tu Traefik (resolvedor ACME). Ajusta al nombre real que uses.
LAB_CERTRESOLVER=le
# Rango de tu tailnet, para restringir el panel de administracion.
TAILNET_CIDR=100.64.0.0/10

# --- Imagen y limites por instancia ---
LAB_IMAGE=docker-lab:latest
LAB_MEM_LIMIT_MB=1024
LAB_MEM_RESERVATION_MB=256
LAB_CPUS=2.0
LAB_CPU_SHARES=512
LAB_PIDS_LIMIT=512
LAB_MAX_ACTIVE=30
LAB_IDLE_TIMEOUT_MIN=0
LAB_RECONCILE_CONCURRENCY=4
LAB_ACTION_CONCURRENCY=4

# --- Cache de imagenes (registry pull-through) ---
REGISTRY_MIRROR_URL=http://registry-mirror:5000

# --- Autenticacion del panel de administracion ---
ADMIN_USER=admin
# Generar con: docker compose run --rm orchestrator npm run hash-password -- "tu-clave"
ADMIN_PASSWORD_HASH=
# Generar con: openssl rand -hex 32
SESSION_SECRET=
